package main;

use ecosystem::image::{Rect, Image, Codec, RawRgbaCodec};
use ecosystem::image::draw;
use ecosystem::image::png;
use ecosystem::image::jpeg;
use ecosystem::image::webp;
use ecosystem::image::transform;
use ecosystem::color::{Rgba8};
use std::testing;

pub fn exercise() -> () {
    let bounds = testing::expect_ok(Rect::new(0, 0, 2, 1), "bounds");
    let background = testing::expect_ok(Rgba8::new(0, 0, 255, 255), "background");
    let foreground = testing::expect_ok(Rgba8::new(128, 0, 0, 128), "foreground");
    let canvas = testing::expect_ok(Image::filled(bounds, background), "canvas");
    let source = testing::expect_ok(Image::filled(bounds, foreground), "source");
    testing::assert_eq(testing::expect_ok(draw::over(canvas, bounds, source, (0, 0)), "over"), 2);
    let encoded = testing::expect_ok(RawRgbaCodec::new().encode(canvas), "encode");
    let decoded = testing::expect_ok(RawRgbaCodec::new().decode(encoded), "decode");
    testing::assert(
        decoded.at(0, 0)
            == Option::Some(testing::expect_ok(Rgba8::new(128, 0, 127, 255), "blended")),
    );
    let png_wire = testing::expect_ok(png::encode(canvas), "PNG encode");
    let png_image = testing::expect_ok(png::decode(png_wire), "PNG decode");
    testing::assert(png_image.at(0, 0) == decoded.at(0, 0));
}

pub fn thumbnail(source: Image) -> Image {
    let bounds = source.bounds();
    let selected = testing::expect_ok(transform::crop(source, bounds), "thumbnail crop");
    testing::expect_ok(
        transform::resize(selected, 4, 4, transform::Filter::Bilinear),
        "thumbnail resize",
    )
}

pub fn exercise_codecs() -> () {
    let bounds = testing::expect_ok(Rect::new(-2, 3, 0, 5), "thumbnail source bounds");
    let pixel = testing::expect_ok(Rgba8::new(128, 0, 0, 128), "thumbnail color");
    let source = testing::expect_ok(Image::filled(bounds, pixel), "thumbnail source");
    let result = thumbnail(source);
    let webp_wire = testing::expect_ok(webp::encode(result), "thumbnail WebP");
    let decoded = testing::expect_ok(webp::decode(webp_wire), "thumbnail WebP decode");
    testing::assert(decoded.pixels() == result.pixels());
    let jpeg_wire = testing::expect_ok(jpeg::encode(result), "thumbnail JPEG");
    let opaque = testing::expect_ok(jpeg::decode(jpeg_wire), "thumbnail JPEG decode");
    testing::assert_eq(opaque.len(), 16);
    testing::assert_eq(testing::expect_some(opaque.at(0, 0), "opaque thumbnail").alpha(), 255);
}

fn main() -> () {
    exercise();
    exercise_codecs();
    println("image consumer: draw, PNG, JPEG, WebP and thumbnail transforms ok");
}
