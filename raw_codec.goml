package image;

use ecosystem::color::{Rgba8};
use std::bytes;

pub struct RawRgbaCodec {}

impl RawRgbaCodec {
    pub fn new() -> RawRgbaCodec {
        RawRgbaCodec {}
    }
}

fn read_word(data: bytes::Bytes, offset: isize) -> u32 {
    data.get(offset).to_u32() | (data.get(offset + 1).to_u32() << 8)
        | (data.get(offset + 2).to_u32() << 16)
        | (data.get(offset + 3).to_u32() << 24)
}

fn write_word(data: bytes::Bytes, value: u32) -> () {
    data.push(value.to_u8());
    data.push((value >> 8).to_u8());
    data.push((value >> 16).to_u8());
    data.push((value >> 24).to_u8());
}

impl Codec for RawRgbaCodec {
    fn decode(self: RawRgbaCodec, data: bytes::Bytes) -> Result[Image, Error] {
        if data.len() < 12 || data.get(0) != b'R' || data.get(1) != b'8' || data.get(2) != b'P'
            || data.get(3) != b'M' {
            return Result::Err(Error::Codec("invalid R8PM header"))
        }
        let width = read_word(data, 4);
        let height = read_word(data, 8);
        if width > MAX_DIMENSION.to_u32() || height > MAX_DIMENSION.to_u32()
            || width * height > MAX_PIXELS.to_u32() {
            return Result::Err(Error::Codec("R8PM dimensions exceed limits"))
        }
        let count = (width * height).to_isize();
        if data.len() != 12 + count * 4 {
            return Result::Err(Error::Codec("R8PM pixel data length mismatch"))
        }
        let pixels: Vec[Rgba8] = Vec::with_capacity(count);
        for index in 0..count {
            let offset = 12 + index * 4;
            pixels.push(
                Rgba8::new(
                    data.get(offset),
                    data.get(offset + 1),
                    data.get(offset + 2),
                    data.get(offset + 3),
                ).map_err(|_| Error::Codec("R8PM channel exceeds alpha"))?,
            );
        }
        let bounds = Rect::new(0, 0, width.to_isize(), height.to_isize())?;
        Image::from_pixels(bounds, pixels)
    }

    fn encode(self: RawRgbaCodec, image: Image) -> Result[bytes::Bytes, Error] {
        let bounds = image.bounds();
        if bounds.min_x() != 0 || bounds.min_y() != 0 {
            return Result::Err(Error::Codec("R8PM requires zero image origin"))
        }
        let output = bytes::Bytes::with_capacity(12 + image.len() * 4);
        output.push(b'R');
        output.push(b'8');
        output.push(b'P');
        output.push(b'M');
        write_word(output, bounds.width().to_u32());
        write_word(output, bounds.height().to_u32());
        for pixel in image.pixels() {
            output.push(pixel.red());
            output.push(pixel.green());
            output.push(pixel.blue());
            output.push(pixel.alpha());
        }
        Result::Ok(output)
    }
}
