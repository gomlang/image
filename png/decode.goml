package png;

use ecosystem::image::{Image, Rect, Error, MAX_DIMENSION};
use ecosystem::color::{Nrgba8, Rgba8};
use ecosystem::compress::zlib;
use std::bytes;
use std::hash::crc32;

struct Header {
    width: isize,
    height: isize,
    depth: isize,
    color_type: isize,
    interlace: isize,
}

struct Parsed {
    header: Header,
    palette: bytes::Bytes,
    transparency: bytes::Bytes,
    compressed: bytes::Bytes,
}

fn channels(color_type: isize) -> isize {
    match color_type {
        0 => 1,
        2 => 3,
        3 => 1,
        4 => 2,
        6 => 4,
        _ => 0,
    }
}

fn valid_depth(color_type: isize, depth: isize) -> bool {
    match color_type {
        0 => depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16,
        2 => depth == 8 || depth == 16,
        3 => depth == 1 || depth == 2 || depth == 4 || depth == 8,
        4 => depth == 8 || depth == 16,
        6 => depth == 8 || depth == 16,
        _ => false,
    }
}

fn parse_header(data: bytes::Bytes, offset: isize, length: isize, limits: Limits) -> Result[
    Header,
    Error,
] {
    if length != 13 {
        return Result::Err(failure("IHDR must be 13 bytes"))
    }
    let width = read_be32(data, offset);
    let height = read_be32(data, offset + 4);
    if width == 0 || height == 0 || width > MAX_DIMENSION.to_u32()
        || height > MAX_DIMENSION.to_u32()
        || width * height > limits.max_pixels.to_u32() {
        return Result::Err(failure("PNG dimensions exceed limits"))
    }
    let depth = data.get(offset + 8).to_isize();
    let color_type = data.get(offset + 9).to_isize();
    let interlace = data.get(offset + 12).to_isize();
    if !valid_depth(color_type, depth) || data.get(offset + 10) != 0 || data.get(offset + 11) != 0
        || (interlace != 0 && interlace != 1) {
        return Result::Err(failure("unsupported PNG header fields"))
    }
    Result::Ok(
        Header { width: width.to_isize(), height: height.to_isize(), depth, color_type, interlace },
    )
}

fn parse_chunks(data: bytes::Bytes, limits: Limits) -> Result[Parsed, Error] {
    limits.validate()?;
    if data.len() > limits.max_input_bytes {
        return Result::Err(failure("PNG input byte limit exceeded"))
    }
    if data.len() < 8 || data.get(0) != 137 || data.get(1) != b'P' || data.get(2) != b'N'
        || data.get(3) != b'G'
        || data.get(4) != 13
        || data.get(5) != 10
        || data.get(6) != 26
        || data.get(7) != 10 {
        return Result::Err(failure("invalid PNG signature"))
    }
    let mut offset = 8;
    let mut count = 0;
    let mut header: Option[Header] = Option::None;
    let mut seen_palette = false;
    let mut seen_transparency = false;
    let mut seen_idat = false;
    let mut idat_closed = false;
    let palette = bytes::Bytes::new();
    let transparency = bytes::Bytes::new();
    let compressed = bytes::Bytes::new();
    let table = crc32::Table::new(crc32::IEEE);
    while offset < data.len() {
        if count >= limits.max_chunks {
            return Result::Err(failure("PNG chunk limit exceeded"))
        }
        count += 1;
        if data.len() - offset < 12 {
            return Result::Err(failure("truncated PNG chunk"))
        }
        let length_word = read_be32(data, offset);
        if length_word > 2147483647 || length_word > (data.len() - offset - 12).to_u32() {
            return Result::Err(failure("invalid PNG chunk length"))
        }
        let length = length_word.to_isize();
        let type_offset = offset + 4;
        let start = offset + 8;
        let end = start + length;
        if !valid_chunk_type(data, type_offset) {
            return Result::Err(failure("invalid PNG chunk type"))
        }
        if checksum(data, type_offset, end, table) != read_be32(data, end) {
            return Result::Err(failure("PNG chunk CRC mismatch"))
        }
        let ihdr = chunk_type_is(data, type_offset, b'I', b'H', b'D', b'R');
        let plte = chunk_type_is(data, type_offset, b'P', b'L', b'T', b'E');
        let trns = chunk_type_is(data, type_offset, b't', b'R', b'N', b'S');
        let idat = chunk_type_is(data, type_offset, b'I', b'D', b'A', b'T');
        let iend = chunk_type_is(data, type_offset, b'I', b'E', b'N', b'D');
        if count == 1 && !ihdr {
            return Result::Err(failure("IHDR must be first"))
        }
        if seen_idat && !idat {
            idat_closed = true;
        }
        if ihdr {
            if count != 1 {
                return Result::Err(failure("duplicate IHDR"))
            }
            header = Option::Some(parse_header(data, start, length, limits)?);
        } else if plte {
            let value = header.ok_or(failure("PLTE before IHDR"))?;
            if seen_palette || seen_transparency || seen_idat || value.color_type == 0
                || value.color_type == 4
                || length == 0
                || length > 768
                || length % 3 != 0
                || (value.color_type == 3 && length / 3 > (1 << value.depth)) {
                return Result::Err(failure("invalid PLTE chunk"))
            }
            seen_palette = true;
            palette.extend_from_slice(data.slice(start, end));
        } else if trns {
            let value = header.ok_or(failure("tRNS before IHDR"))?;
            if seen_transparency || seen_idat || value.color_type == 4 || value.color_type == 6 {
                return Result::Err(failure("invalid tRNS placement"))
            }
            if (value.color_type == 0 && length != 2) || (value.color_type == 2 && length != 6)
                || (value.color_type == 3
                    && (!seen_palette || length == 0 || length > palette.len() / 3)) {
                return Result::Err(failure("invalid tRNS length"))
            }
            seen_transparency = true;
            transparency.extend_from_slice(data.slice(start, end));
        } else if idat {
            let value = header.ok_or(failure("IDAT before IHDR"))?;
            if idat_closed || (value.color_type == 3 && !seen_palette) {
                return Result::Err(failure("invalid IDAT placement"))
            }
            if length > limits.max_compressed_bytes - compressed.len() {
                return Result::Err(failure("PNG compressed byte limit exceeded"))
            }
            seen_idat = true;
            compressed.extend_from_slice(data.slice(start, end));
        } else if iend {
            if length != 0 || !seen_idat || end + 4 != data.len() {
                return Result::Err(failure("invalid IEND chunk"))
            }
            return Result::Ok(
                Parsed {
                    header: header.ok_or(failure("missing IHDR"))?,
                    palette,
                    transparency,
                    compressed,
                },
            )
        } else if data.get(type_offset) >= b'A' && data.get(type_offset) <= b'Z' {
            return Result::Err(failure("unknown critical PNG chunk"))
        }
        offset = end + 4;
    }
    Result::Err(failure("missing PNG IEND"))
}

fn pass_spec(pass: isize, interlace: isize) -> (isize, isize, isize, isize) {
    if interlace == 0 {
        return (0, 0, 1, 1)
    }
    match pass {
        0 => (0, 0, 8, 8),
        1 => (4, 0, 8, 8),
        2 => (0, 4, 4, 8),
        3 => (2, 0, 4, 4),
        4 => (0, 2, 2, 4),
        5 => (1, 0, 2, 2),
        _ => (0, 1, 1, 2),
    }
}

fn pass_dimension(length: isize, start: isize, step: isize) -> isize {
    if length <= start {
        0
    } else {
        (length - start + step - 1) / step
    }
}

fn row_bytes(width: isize, channel_count: isize, depth: isize) -> isize {
    (width * channel_count * depth + 7) / 8
}

fn expected_size(header: Header) -> isize {
    let mut count = 0;
    let passes = if header.interlace == 0 {
        1
    } else {
        7
    };
    for pass in 0..passes {
        let (start_x, start_y, step_x, step_y) = pass_spec(pass, header.interlace);
        let width = pass_dimension(header.width, start_x, step_x);
        let height = pass_dimension(header.height, start_y, step_y);
        if width > 0 && height > 0 {
            count += height * (1 + row_bytes(width, channels(header.color_type), header.depth));
        }
    }
    count
}

fn abs(value: isize) -> isize {
    if value < 0 {
        -value
    } else {
        value
    }
}

fn paeth(left: isize, above: isize, upper_left: isize) -> isize {
    let estimate = left + above - upper_left;
    let dl = abs(estimate - left);
    let da = abs(estimate - above);
    let du = abs(estimate - upper_left);
    if dl <= da && dl <= du {
        left
    } else if da <= du {
        above
    } else {
        upper_left
    }
}

fn unfilter(
    data: bytes::Bytes,
    offset: isize,
    length: isize,
    previous: Vec[byte],
    bytes_per_pixel: isize,
) -> Result[Vec[byte], Error] {
    let filter = data.get(offset);
    if filter > 4 {
        return Result::Err(failure("invalid PNG row filter"))
    }
    let output: Vec[byte] = Vec::with_capacity(length);
    for index in 0..length {
        let left = if index >= bytes_per_pixel {
            output[index - bytes_per_pixel].to_isize()
        } else {
            0
        };
        let above = previous[index].to_isize();
        let upper_left = if index >= bytes_per_pixel {
            previous[index - bytes_per_pixel].to_isize()
        } else {
            0
        };
        let predictor = match filter {
            0 => 0,
            1 => left,
            2 => above,
            3 => (left + above) / 2,
            _ => paeth(left, above, upper_left),
        };
        output.push(((data.get(offset + 1 + index).to_isize() + predictor) & 255).to_u8());
    }
    Result::Ok(output)
}

fn sample(row: Vec[byte], index: isize, depth: isize) -> u16 {
    if depth == 16 {
        ((row[index * 2].to_u32() << 8) | row[index * 2 + 1].to_u32()).to_u16()
    } else if depth == 8 {
        row[index].to_u16()
    } else {
        let bit = index * depth;
        let shift = 8 - depth - bit % 8;
        ((row[bit / 8].to_u32() >> shift) & ((1 << depth) - 1).to_u32()).to_u16()
    }
}

fn to_byte(value: u16, depth: isize) -> byte {
    if depth == 16 {
        ((value.to_u32() * 255 + 32767) / 65535).to_u8()
    } else if depth == 8 {
        value.to_u8()
    } else {
        ((value.to_u32() * 255) / ((1 << depth) - 1).to_u32()).to_u8()
    }
}

fn decoded_pixel(row: Vec[byte], column: isize, parsed: Parsed) -> Result[Rgba8, Error] {
    let depth = parsed.header.depth;
    let color_type = parsed.header.color_type;
    let base = column * channels(color_type);
    let mut red: byte = 0;
    let mut green: byte = 0;
    let mut blue: byte = 0;
    let mut alpha: byte = 255;
    if color_type == 0 || color_type == 4 {
        let gray = sample(row, base, depth);
        red = to_byte(gray, depth);
        green = red;
        blue = red;
        if color_type == 4 {
            alpha = to_byte(sample(row, base + 1, depth), depth);
        } else if parsed.transparency.len() == 2 {
            let key = read_be16(parsed.transparency, 0).to_u32() & ((1 << depth) - 1).to_u32();
            if gray.to_u32() == key {
                alpha = 0;
            }
        }
    } else if color_type == 3 {
        let index = sample(row, base, depth).to_isize();
        if index >= parsed.palette.len() / 3 {
            return Result::Err(failure("PNG palette index out of range"))
        }
        red = parsed.palette.get(index * 3);
        green = parsed.palette.get(index * 3 + 1);
        blue = parsed.palette.get(index * 3 + 2);
        if index < parsed.transparency.len() {
            alpha = parsed.transparency.get(index);
        }
    } else {
        let r = sample(row, base, depth);
        let g = sample(row, base + 1, depth);
        let b = sample(row, base + 2, depth);
        red = to_byte(r, depth);
        green = to_byte(g, depth);
        blue = to_byte(b, depth);
        if color_type == 6 {
            alpha = to_byte(sample(row, base + 3, depth), depth);
        } else if parsed.transparency.len() == 6 {
            let mask = ((1 << depth) - 1).to_u32();
            if r.to_u32() == (read_be16(parsed.transparency, 0).to_u32() & mask)
                && g.to_u32() == (read_be16(parsed.transparency, 2).to_u32() & mask)
                && b.to_u32() == (read_be16(parsed.transparency, 4).to_u32() & mask) {
                alpha = 0;
            }
        }
    }
    Result::Ok(Nrgba8::new(red, green, blue, alpha).to_rgba8())
}

pub fn decode_with_limits(data: bytes::Bytes, limits: Limits) -> Result[Image, Error] {
    let parsed = parse_chunks(data, limits)?;
    let expected = expected_size(parsed.header);
    if expected > limits.max_inflated_bytes {
        return Result::Err(failure("PNG inflated byte limit exceeded"))
    }
    let inflated = zlib::decode(
        parsed.compressed,
        compression_limits(limits, parsed.compressed.len(), expected),
    ).map_err(|error| failure("PNG zlib: " + error.to_string()))?;
    if inflated.len() != expected {
        return Result::Err(failure("PNG inflated data length mismatch"))
    }
    let bounds = Rect::new(0, 0, parsed.header.width, parsed.header.height)?;
    let image = Image::new(bounds)?;
    let mut offset = 0;
    let passes = if parsed.header.interlace == 0 {
        1
    } else {
        7
    };
    for pass in 0..passes {
        let (start_x, start_y, step_x, step_y) = pass_spec(pass, parsed.header.interlace);
        let width = pass_dimension(parsed.header.width, start_x, step_x);
        let height = pass_dimension(parsed.header.height, start_y, step_y);
        if width == 0 || height == 0 {
            continue
        }
        let length = row_bytes(width, channels(parsed.header.color_type), parsed.header.depth);
        let bpp = (channels(parsed.header.color_type) * parsed.header.depth + 7) / 8;
        let bpp = if bpp < 1 {
            1
        } else {
            bpp
        };
        let mut previous: Vec[byte] = Vec::with_capacity(length);
        for _ in 0..length {
            previous.push(0);
        }
        for row in 0..height {
            let current = unfilter(inflated, offset, length, previous, bpp)?;
            for column in 0..width {
                image.set(
                    start_x + column * step_x,
                    start_y + row * step_y,
                    decoded_pixel(current, column, parsed)?,
                )?;
            }
            previous = current;
            offset += 1 + length;
        }
    }
    Result::Ok(image)
}
