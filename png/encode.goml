package png;

use ecosystem::image::{Image, Error};
use ecosystem::compress::zlib;
use std::bytes;
use std::hash::crc32;

fn append_chunk(
    output: bytes::Bytes,
    chunk_type: bytes::Bytes,
    payload: bytes::Bytes,
    table: crc32::Table,
) -> () {
    write_be32(output, payload.len().to_u32());
    let start = output.len();
    output.extend_from_slice(chunk_type.as_slice());
    output.extend_from_slice(payload.as_slice());
    write_be32(output, checksum(output, start, output.len(), table));
}

fn filtered_row(row: bytes::Bytes, previous: bytes::Bytes, filter: isize, channels: isize) -> (
    bytes::Bytes,
    isize,
) {
    let result = bytes::Bytes::with_capacity(row.len());
    let mut score = 0;
    for index in 0..row.len() {
        let left = if index >= channels {
            row.get(index - channels).to_isize()
        } else {
            0
        };
        let above = previous.get(index).to_isize();
        let upper_left = if index >= channels {
            previous.get(index - channels).to_isize()
        } else {
            0
        };
        let predictor = match filter {
            0 => 0,
            1 => left,
            2 => above,
            3 => (left + above) / 2,
            _ => paeth(left, above, upper_left),
        };
        let residual = (row.get(index).to_isize() - predictor) & 255;
        result.push(residual.to_u8());
        score += if residual < 128 {
            residual
        } else {
            256 - residual
        };
    }
    return (result, score)
}

fn append_filtered_row(
    output: bytes::Bytes,
    row: bytes::Bytes,
    previous: bytes::Bytes,
    policy: Filter,
    channels: isize,
) -> () {
    let fixed = policy.code();
    if fixed == 0 {
        output.push(0);
        output.extend_from_slice(row.as_slice());
        return
    }
    if fixed >= 0 {
        let (filtered, _) = filtered_row(row, previous, fixed, channels);
        output.push(fixed.to_u8());
        output.extend_from_slice(filtered.as_slice());
        return
    }
    let (mut selected, mut score) = filtered_row(row, previous, 0, channels);
    let mut chosen = 0;
    for filter in 1..5 {
        let (candidate, candidate_score) = filtered_row(row, previous, filter, channels);
        if candidate_score < score {
            selected = candidate;
            score = candidate_score;
            chosen = filter;
        }
    }
    output.push(chosen.to_u8());
    output.extend_from_slice(selected.as_slice());
}

pub fn encode_with_limits(image: Image, limits: Limits, level: isize) -> Result[bytes::Bytes, Error] {
    encode_with_options(image, limits, EncodeOptions { level, ..EncodeOptions::standard() })
}

pub fn encode_with_options(image: Image, limits: Limits, options: EncodeOptions) -> Result[
    bytes::Bytes,
    Error,
] {
    limits.validate()?;
    let level = options.level;
    if level < 0 || level > 9 {
        return Result::Err(failure("PNG compression level must be 0 through 9"))
    }
    let bounds = image.bounds();
    if bounds.min_x() != 0 || bounds.min_y() != 0 || bounds.is_empty() {
        return Result::Err(failure("PNG requires a nonempty image at origin (0,0)"))
    }
    if image.len() > limits.max_pixels {
        return Result::Err(failure("PNG pixel limit exceeded"))
    }
    let color_type = options.encoding.code();
    let channel_count = channels(color_type);
    let expected = bounds.height() * (1 + bounds.width() * channel_count);
    if expected > limits.max_inflated_bytes {
        return Result::Err(failure("PNG inflated byte limit exceeded"))
    }
    let rows = bytes::Bytes::with_capacity(expected);
    let mut previous = bytes::Bytes::new();
    for _ in 0..bounds.width() * channel_count {
        previous.push(0);
    }
    for y in 0..bounds.height() {
        let row = bytes::Bytes::with_capacity(bounds.width() * channel_count);
        for x in 0..bounds.width() {
            let pixel = image.at(x, y).ok_or(failure("PNG image bounds changed"))?;
            let straight = pixel.to_nrgba8();
            if (color_type == 0 || color_type == 2) && straight.alpha() != 255 {
                return Result::Err(failure("PNG selected encoding requires opaque pixels"))
            }
            if (color_type == 0 || color_type == 4)
                && (straight.red() != straight.green() || straight.red() != straight.blue()) {
                return Result::Err(failure("PNG grayscale encoding requires equal color channels"))
            }
            row.push(straight.red());
            if color_type == 2 || color_type == 6 {
                row.push(straight.green());
                row.push(straight.blue());
            }
            if color_type == 4 || color_type == 6 {
                row.push(straight.alpha());
            }
        }
        append_filtered_row(rows, row, previous, options.filter, channel_count);
        previous = row;
    }
    let compressed = zlib::encode(
        rows,
        compression_limits(limits, rows.len(), limits.max_compressed_bytes),
        level,
    ).map_err(|error| failure("PNG zlib: " + error.to_string()))?;
    if compressed.len() > limits.max_compressed_bytes {
        return Result::Err(failure("PNG compressed byte limit exceeded"))
    }
    if compressed.len() + 57 > limits.max_input_bytes {
        return Result::Err(failure("PNG output byte limit exceeded"))
    }
    if limits.max_chunks < 3 {
        return Result::Err(failure("PNG chunk limit exceeded"))
    }
    let result = bytes::Bytes::with_capacity(compressed.len() + 57);
    for byte in Vec::from_array(
        [137.to_u8(), b'P', b'N', b'G', 13.to_u8(), 10.to_u8(), 26.to_u8(), 10.to_u8()],
    ) {
        result.push(byte);
    }
    let header = bytes::Bytes::with_capacity(13);
    write_be32(header, bounds.width().to_u32());
    write_be32(header, bounds.height().to_u32());
    header.push(8);
    header.push(color_type.to_u8());
    header.push(0);
    header.push(0);
    header.push(0);
    let table = crc32::Table::new(crc32::IEEE);
    append_chunk(result, bytes::Bytes::from_string("IHDR"), header, table);
    append_chunk(result, bytes::Bytes::from_string("IDAT"), compressed, table);
    append_chunk(result, bytes::Bytes::from_string("IEND"), bytes::Bytes::new(), table);
    Result::Ok(result)
}
