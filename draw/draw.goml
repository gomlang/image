package draw;

use ecosystem::image::{Image, Rect, Error, MAX_COORDINATE};
use ecosystem::color::{Rgba8};

#[derive(Debug, PartialEq, Eq)]
pub enum Op {
    Src,
    Over,
}

fn blend_channel(source: u8, destination: u8, inverse_alpha: u32) -> u8 {
    (source.to_u32() + (destination.to_u32() * inverse_alpha + 127) / 255).to_u8()
}

fn blend(source: Rgba8, destination: Rgba8) -> Result[Rgba8, Error] {
    let inverse_alpha = 255 - source.alpha().to_u32();
    Rgba8::new(
        blend_channel(source.red(), destination.red(), inverse_alpha),
        blend_channel(source.green(), destination.green(), inverse_alpha),
        blend_channel(source.blue(), destination.blue(), inverse_alpha),
        blend_channel(source.alpha(), destination.alpha(), inverse_alpha),
    ).map_err(|_| Error::InvalidPixel)
}

pub fn draw(destination: Image, region: Rect, source: Image, source_origin: (isize, isize), op: Op) -> Result[
    isize,
    Error,
] {
    if source_origin.0 < -MAX_COORDINATE || source_origin.0 > MAX_COORDINATE
        || source_origin.1 < -MAX_COORDINATE
        || source_origin.1 > MAX_COORDINATE {
        return Result::Err(Error::OutOfBounds)
    }
    let clipped = region.intersection(destination.bounds());
    let source_pixels: Vec[Option[Rgba8]] = Vec::with_capacity(clipped.width() * clipped.height());
    for y in clipped.min_y()..clipped.max_y() {
        for x in clipped.min_x()..clipped.max_x() {
            let source_x = source_origin.0 + (x - region.min_x());
            let source_y = source_origin.1 + (y - region.min_y());
            source_pixels.push(source.at(source_x, source_y));
        }
    }
    let mut index = 0;
    let mut written = 0;
    for y in clipped.min_y()..clipped.max_y() {
        for x in clipped.min_x()..clipped.max_x() {
            match source_pixels[index] {
                Some(pixel) => {
                    let result = match op {
                        Op::Src => pixel,
                        Op::Over => {
                            let underlying = destination.at(x, y).ok_or(Error::OutOfBounds)?;
                            blend(pixel, underlying)?
                        },
                    };
                    destination.set(x, y, result)?;
                    written += 1;
                },
                None => {},
            }
            index += 1;
        }
    }
    Result::Ok(written)
}

pub fn copy(destination: Image, region: Rect, source: Image, source_origin: (isize, isize)) -> Result[
    isize,
    Error,
] {
    draw(destination, region, source, source_origin, Op::Src)
}

pub fn over(destination: Image, region: Rect, source: Image, source_origin: (isize, isize)) -> Result[
    isize,
    Error,
] {
    draw(destination, region, source, source_origin, Op::Over)
}
