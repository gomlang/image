package tests;

use ecosystem::image::{Image, Rect};
use ecosystem::image::draw::{draw, Op};
use ecosystem::color::{Rgba8};
use std::testing;

fn patterned(bounds: Rect) -> Image {
    let pixels = Vec::new();
    for index in 0..bounds.width() * bounds.height() {
        let alpha = (index * 51) % 256;
        pixels.push(
            pixel(
                ((index * 19) % (alpha + 1)).to_u8(),
                ((index * 43) % (alpha + 1)).to_u8(),
                ((index * 71) % (alpha + 1)).to_u8(),
                alpha.to_u8(),
            ),
        );
    }
    testing::expect_ok(Image::from_pixels(bounds, pixels), "pattern")
}

fn oracle_channel(source: u8, destination: u8, alpha: u8) -> u8 {
    let numerator = destination.to_isize() * (255 - alpha.to_isize());
    let rounded = numerator / 255
        + if numerator % 255 >= 128 {
            1
        } else {
            0
        };
    (source.to_isize() + rounded).to_u8()
}

fn oracle_over(source: Rgba8, destination: Rgba8) -> Rgba8 {
    pixel(
        oracle_channel(source.red(), destination.red(), source.alpha()),
        oracle_channel(source.green(), destination.green(), source.alpha()),
        oracle_channel(source.blue(), destination.blue(), source.alpha()),
        oracle_channel(source.alpha(), destination.alpha(), source.alpha()),
    )
}

fn verify_grid_draw(
    destination: Image,
    region: Rect,
    source: Image,
    source_origin: (isize, isize),
    op: Op,
) -> () {
    // Visit the complete destination grid, deciding each pixel independently
    // without computing a clipped rectangle. Finish before any actual writes.
    let expected = Vec::new();
    let mut count = 0;
    let bounds = destination.bounds();
    for y in bounds.min_y()..bounds.max_y() {
        for x in bounds.min_x()..bounds.max_x() {
            let original = testing::expect_some(destination.at(x, y), "destination pixel");
            let selected = if region.contains(x, y) {
                source.at(
                    source_origin.0 + x - region.min_x(),
                    source_origin.1 + y - region.min_y(),
                )
            } else {
                Option::None
            };
            match selected {
                Some(value) => {
                    expected.push(
                        match op {
                            Op::Src => value,
                            Op::Over => oracle_over(value, original),
                        },
                    );
                    count += 1;
                },
                None => expected.push(original),
            }
        }
    }
    testing::assert_eq(
        testing::expect_ok(draw(destination, region, source, source_origin, op), "draw"),
        count,
    );
    testing::assert(destination.pixels() == expected);
}

#[test]
fn clipped_draw_matches_full_destination_grid_oracle() -> () {
    let original = patterned(rect(-1, 2, 3, 5));
    let source = patterned(rect(-2, -1, 1, 1));
    let origins = Vec::from_array([(-3, -2), (-2, -1), (-1, 0), (0, 1), (2, 3)]);
    for y in 0..6 {
        for x in -3..4 {
            for origin in origins {
                for op in Vec::from_array([Op::Src, Op::Over]) {
                    verify_grid_draw(
                        original.snapshot(),
                        rect(x, y, x + 4, y + 3),
                        source,
                        origin,
                        op,
                    );
                }
            }
        }
    }
    for bounds in Vec::from_array([rect(-2, -1, -2, 1), rect(-2, -1, 1, -1)]) {
        for op in Vec::from_array([Op::Src, Op::Over]) {
            verify_grid_draw(
                original.snapshot(),
                rect(-1, 2, 3, 5),
                patterned(bounds),
                (-2, -1),
                op,
            );
            verify_grid_draw(patterned(bounds), rect(-2, -1, 1, 1), source, (-2, -1), op);
        }
    }
}

#[test]
fn overlapping_draw_matches_original_grid_in_every_direction() -> () {
    let original = patterned(rect(-1, 2, 3, 5));
    let regions = Vec::from_array(
        [
            rect(-2, 1, 3, 5),
            rect(-1, 2, 3, 5),
            rect(0, 3, 3, 5),
            rect(-1, 2, -1, 5),
            rect(-1, 2, 3, 2),
        ],
    );
    for y in 0..6 {
        for x in -3..5 {
            for region in regions {
                for op in Vec::from_array([Op::Src, Op::Over]) {
                    let image = original.snapshot();
                    verify_grid_draw(image, region, image, (x, y), op);
                }
            }
        }
    }
}
