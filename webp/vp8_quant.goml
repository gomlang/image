package webp;

use std::bytes;

fn vp8_clip(x: isize, min: isize, max: isize) -> isize {
    let mut x = x;
    let mut min = min;
    let mut max = max;
    if (x < min) {
        return min;
    }
    if (x > max) {
        return max;
    }
    return x;
}

fn vp8_parse_quant(d: Ref[Vp8Decoder]) -> () {
    let mut base_q0 = vp8_read_uint(d.get().fp, vp8_uniform_prob, 7);
    let mut dqy1_dc = vp8_read_optional_int(d.get().fp, vp8_uniform_prob, 4);
    let mut dqy1_ac: isize = 0;
    let mut dqy2_dc = vp8_read_optional_int(d.get().fp, vp8_uniform_prob, 4);
    let mut dqy2_ac = vp8_read_optional_int(d.get().fp, vp8_uniform_prob, 4);
    let mut dquv_dc = vp8_read_optional_int(d.get().fp, vp8_uniform_prob, 4);
    let mut dquv_ac = vp8_read_optional_int(d.get().fp, vp8_uniform_prob, 4);
    {
        let mut i = 0;
        while (i < vp8_n_segment) {
            let mut q = (base_q0);
            if d.get().segment_header.get().use_segment {
                if d.get().segment_header.get().relative_delta {
                    q = (q + (d.get().segment_header.get().quantizer[i]));
                } else {
                    q = (d.get().segment_header.get().quantizer[i]);
                }
            }
            d.get().quant[i].get().y1[0] = vp8_dequant_table_dc[vp8_clip((q + dqy1_dc), 0, 127)];
            d.get().quant[i].get().y1[1] = vp8_dequant_table_ac[vp8_clip((q + dqy1_ac), 0, 127)];
            d.get().quant[i].get().y2[0] = (vp8_dequant_table_dc[vp8_clip((q + dqy2_dc), 0, 127)]
                * 2);
            d.get().quant[i].get().y2[1] = ((vp8_dequant_table_ac[vp8_clip((q + dqy2_ac), 0, 127)]
                * 155)
                / 100);
            if (d.get().quant[i].get().y2[1] < 8) {
                d.get().quant[i].get().y2[1] = 8;
            }
            d.get().quant[i].get().uv[0] = vp8_dequant_table_dc[vp8_clip((q + dquv_dc), 0, 117)];
            d.get().quant[i].get().uv[1] = vp8_dequant_table_ac[vp8_clip((q + dquv_ac), 0, 127)];
            i = (i + 1);
        }
    };
}

