package webp;

use std::bytes;
use std::testing;

fn vp8_regression_fixture() -> bytes::Bytes {
    bytes::Bytes::from_vec(
        b"\x50\x06\x00\x9d\x01\x2a\x11\x00\x13\x00\x3e\xa9\x40\x9c\x49\x26\x23\xa2\xa1\x30\x18\x0c\x00\xc0\x15\x09\x6c\x00\x9d\x32\x84\x75\x62\xda\x33\x00\xf6\x55\xb8\xcc\xc8\x00\xe9\x47\x01\x31\xc9\x6f\x24\x56\xfe\x80\xb2\x34\x50\xf0\x03\x57\x80\x00\xfe\xf5\xdc\x51\x52\xf9\x7e\xb0\xd2\x8b\x55\x23\xa5\x80\xff\x69\x30\xfc\xdb\x6d\xf8\x78\x89\x4d\x33\xe8\x83\xbc\x37\xe7\x32\xaf\x73\xf0\xad\xc4\xa1\x41\xa1\xdb\x51\xa8\x57\x3e\xb5\x1e\x05\x0b\x58\x06\xc7\xfd\x6f\xcb\xb8\x1c\xbd\x20\x63\x5a\x5a\x4b\xc5\x9a\x3e\xf2\x09\x01\xf5\x2a\xb5\xd8\xd4\x3a\x9a\x4d\x7b\x60\x41\xe5\x16\x65\x15\x3f\x2d\xa2\x97\xcc\x3c\xab\x4f\xe6\x7f\xea\xe6\x9b\x33\xe2\x36\x9f\xe6\xed\xbd\x9d\xbf\x0e\x8b\x0e\x8d\xa9\x61\xd1\x66\xf5\x84\x15\x2d\x11\x3a\x75\xc2\xff\xe8\x25\xbe\x33\x25\x5e\x62\xbb\x1b\x1f\xd1\x5f\x27\xc3\xa2\x2b\x55\xf3\x59\x75\x65\xdf\xb4\x63\xaf\xcf\xb1\xa0\xda\xaf\x44\x11\x99\xa1\xab\xcc\x89\x5f\x86\x4f\xfd\x90\xff\xff\x39\x73\x58\xff\x5d\x8d\xf7\x7f\xbb\xeb\x8e\x33\xdc\xdf\xb0\x85\x9e\x93\xd8\x03\x23\xfb\x37\x33\xb9\x65\x5d\xfa\xc4\x8e\x02\xe8\x00\x00",
    )
}

#[test]
fn vp8_decodes_predicted_filtered_odd_dimensions() -> () {
    let decoded = testing::expect_ok(decode_vp8(vp8_regression_fixture(), 17, 19), "VP8 regression");
    testing::assert_eq(decoded.len(), 323);
    let mut checksum: u32 = 2166136261;
    for pixel in decoded {
        checksum = (checksum * 16777619) ^ pixel;
    }
    testing::assert_eq(checksum, 1003858029);
}

#[test]
fn vp8_rejects_truncated_partitions_and_dimension_mismatches() -> () {
    let encoded = vp8_regression_fixture();
    for length in 0..258 {
        let truncated = bytes::Bytes::from_slice_copy(encoded.slice(0, length));
        testing::assert_err(decode_vp8(truncated, 17, 19));
    }
    testing::assert_err(decode_vp8(encoded, 16, 19));
    testing::assert_err(decode_vp8(encoded, 17, 20));
    testing::assert_err(decode_vp8(encoded, 0, 19));
}

#[test]
fn vp8_handles_mutated_entropy_without_panicking() -> () {
    let encoded = vp8_regression_fixture();
    for index in 0..encoded.len() {
        let changed = bytes::Bytes::from_slice_copy(encoded.slice(0, encoded.len()));
        let bit: u8 = (1 << (index % 8)).to_u8();
        changed.set(index, changed.get(index) ^ bit);
        let _ = decode_vp8(changed, 17, 19);
    }
}
