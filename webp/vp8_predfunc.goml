    let mut d = (z.get().ybr[(y - 1)][(x + 2)]);
    let mut e = (z.get().ybr[(y - 1)][(x + 3)]);
    let mut f = (z.get().ybr[(y - 1)][(x + 4)]);
    let mut abc = ((((((a + (2 * b)) + c) + 2)) / 4));
    let mut bcd = ((((((b + (2 * c)) + d) + 2)) / 4));
    let mut cde = ((((((c + (2 * d)) + e) + 2)) / 4));
    let mut def = ((((((d + (2 * e)) + f) + 2)) / 4));
