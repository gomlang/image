package tests;

use ecosystem::image::{Image, Rect};
use ecosystem::image::png::{PngCodec, Limits};
use ecosystem::image::{Codec};
use ecosystem::color::{Rgba8};
use std::testing;

#[test]
fn published_png_codec_roundtrips_a_premultiplied_pixel() -> () {
    let bounds = testing::expect_ok(Rect::new(0, 0, 1, 1), "bounds");
    let pixel = testing::expect_ok(Rgba8::new(64, 0, 0, 128), "pixel");
    let image = testing::expect_ok(Image::filled(bounds, pixel), "image");
    let codec = testing::expect_ok(PngCodec::new(Limits::standard(), 6), "codec");
    let wire = testing::expect_ok(codec.encode(image), "encode");
    let result = testing::expect_ok(codec.decode(wire), "decode");
    testing::assert(result.at(0, 0) == Option::Some(pixel));
}
