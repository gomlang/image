package jpeg;

fn dct_box(x0: i32, x1: i32, kcos: i32, ksin: i32) -> (i32, i32) {
    let sum = kcos * (x0 + x1);
    (sum + (ksin - kcos) * x1, sum - (kcos + ksin) * x0)
}

fn forward_dct(b: Vec[i32]) -> () {
    forward_columns(b);
    forward_rows(b);
}

fn forward_columns(b: Vec[i32]) -> () {
    for i in 0..8 {
        let mut x0 = b[0 * 8 + i];
        let mut x1 = b[1 * 8 + i];
        let mut x2 = b[2 * 8 + i];
        let mut x3 = b[3 * 8 + i];
        let mut x4 = b[4 * 8 + i];
        let mut x5 = b[5 * 8 + i];
        let mut x6 = b[6 * 8 + i];
        let mut x7 = b[7 * 8 + i];
        let tmp_a0 = x0 + x7;
        let tmp_b0 = x0 - x7;
        x0 = tmp_a0;
        x7 = tmp_b0;
        let tmp_a1 = x1 + x6;
        let tmp_b1 = x1 - x6;
        x1 = tmp_a1;
        x6 = tmp_b1;
        let tmp_a2 = x2 + x5;
        let tmp_b2 = x2 - x5;
        x2 = tmp_a2;
        x5 = tmp_b2;
        let tmp_a3 = x3 + x4;
        let tmp_b3 = x3 - x4;
        x3 = tmp_a3;
        x4 = tmp_b3;
        let (tmp_a4, tmp_b4) = dct_box(x4, x7, 217965, 145639);
        x4 = tmp_a4;
        x7 = tmp_b4;
        let (tmp_a5, tmp_b5) = dct_box(x5, x6, 257107, 51142);
        x5 = tmp_a5;
        x6 = tmp_b5;
        let tmp_a6 = x0 + x3;
        let tmp_b6 = x0 - x3;
        x0 = tmp_a6;
        x3 = tmp_b6;
        let tmp_a7 = x1 + x2;
        let tmp_b7 = x1 - x2;
        x1 = tmp_a7;
        x2 = tmp_b7;
        let (tmp_a8, tmp_b8) = dct_box(x2, x3, 141871, 342508);
        x2 = tmp_a8;
        x3 = tmp_b8;
        let tmp_a9 = x0 + x1;
        let tmp_b9 = x0 - x1;
        x0 = tmp_a9;
        x1 = tmp_b9;
        b[0 * 8 + i] = (x0 - 128 * 8) << 18;
        b[4 * 8 + i] = x1 << 18;
        b[2 * 8 + i] = x2;
        b[6 * 8 + i] = x3;
        let tmp_a10 = x4 + x6;
        let tmp_b10 = x4 - x6;
        x4 = tmp_a10;
        x6 = tmp_b10;
        let tmp_a11 = x7 + x5;
        let tmp_b11 = x7 - x5;
        x7 = tmp_a11;
        x5 = tmp_b11;
        x5 = (x5 >> 12) * 5793;
        x6 = (x6 >> 12) * 5793;
        let tmp_a12 = x7 + x4;
        let tmp_b12 = x7 - x4;
        x7 = tmp_a12;
        x4 = tmp_b12;
        b[1 * 8 + i] = x7;
        b[3 * 8 + i] = x5;
        b[5 * 8 + i] = x6;
        b[7 * 8 + i] = x4;
    }
}

fn forward_rows(b: Vec[i32]) -> () {
    for i in 0..8 {
        let mut x0 = b[8 * i + 0];
        let mut x1 = b[8 * i + 1];
        let mut x2 = b[8 * i + 2];
        let mut x3 = b[8 * i + 3];
        let mut x4 = b[8 * i + 4];
        let mut x5 = b[8 * i + 5];
        let mut x6 = b[8 * i + 6];
        let mut x7 = b[8 * i + 7];
        let tmp_a0 = x0 + x7;
        let tmp_b0 = x0 - x7;
        x0 = tmp_a0;
        x7 = tmp_b0;
        let tmp_a1 = x1 + x6;
        let tmp_b1 = x1 - x6;
        x1 = tmp_a1;
        x6 = tmp_b1;
        let tmp_a2 = x2 + x5;
        let tmp_b2 = x2 - x5;
        x2 = tmp_a2;
        x5 = tmp_b2;
        let tmp_a3 = x3 + x4;
        let tmp_b3 = x3 - x4;
        x3 = tmp_a3;
        x4 = tmp_b3;
        let (tmp_a4, tmp_b4) = dct_box(x4 >> 14, x7 >> 14, 13623, 9102);
        x4 = tmp_a4;
        x7 = tmp_b4;
        let (tmp_a5, tmp_b5) = dct_box(x5 >> 14, x6 >> 14, 16069, 3196);
        x5 = tmp_a5;
        x6 = tmp_b5;
        let tmp_a6 = x0 + x3;
        let tmp_b6 = x0 - x3;
        x0 = tmp_a6;
        x3 = tmp_b6;
        let tmp_a7 = x1 + x2;
        let tmp_b7 = x1 - x2;
        x1 = tmp_a7;
        x2 = tmp_b7;
        let (tmp_a8, tmp_b8) = dct_box(x2 >> 14, x3 >> 14, 8867, 21407);
        x2 = tmp_a8;
        x3 = tmp_b8;
        let tmp_a9 = x0 + x1;
        let tmp_b9 = x0 - x1;
        x0 = tmp_a9;
        x1 = tmp_b9;
        let tmp_a10 = x4 + x6;
        let tmp_b10 = x4 - x6;
        x4 = tmp_a10;
        x6 = tmp_b10;
        let tmp_a11 = x7 + x5;
        let tmp_b11 = x7 - x5;
        x7 = tmp_a11;
        x5 = tmp_b11;
        x5 = (x5 >> 14) * 23170;
        x6 = (x6 >> 14) * 23170;
        let tmp_a12 = x7 + x4;
        let tmp_b12 = x7 - x4;
        x7 = tmp_a12;
        x4 = tmp_b12;
        x0 = (x0 + (1 << 17)) >> 18;
        x1 = (x1 + (1 << 17)) >> 18;
        x2 = (x2 + (1 << 17)) >> 18;
        x3 = (x3 + (1 << 17)) >> 18;
        x4 = (x4 + (1 << 17)) >> 18;
        x5 = (x5 + (1 << 17)) >> 18;
        x6 = (x6 + (1 << 17)) >> 18;
        x7 = (x7 + (1 << 17)) >> 18;
        b[8 * i + 0] = x0;
        b[8 * i + 1] = x7;
        b[8 * i + 2] = x2;
        b[8 * i + 3] = x5;
        b[8 * i + 4] = x1;
        b[8 * i + 5] = x6;
        b[8 * i + 6] = x3;
        b[8 * i + 7] = x4;
    }
}

fn inverse_dct(b: Vec[i32]) -> () {
    inverse_rows(b);
    inverse_columns(b);
}

fn inverse_rows(b: Vec[i32]) -> () {
    for i in 0..8 {
        let mut x0 = b[8 * i + 0];
        let mut x7 = b[8 * i + 1];
        let mut x2 = b[8 * i + 2];
        let mut x5 = b[8 * i + 3];
        let mut x1 = b[8 * i + 4];
        let mut x6 = b[8 * i + 5];
        let mut x3 = b[8 * i + 6];
        let mut x4 = b[8 * i + 7];
        x0 <<= 17;
        x1 <<= 17;
        let tmp_a0 = x0 + x1;
        let tmp_b0 = x0 - x1;
        x0 = tmp_a0;
        x1 = tmp_b0;
        let (tmp_a1, tmp_b1) = dct_box(x2, x3, 70936, -171254);
        x2 = tmp_a1;
        x3 = tmp_b1;
        let tmp_a2 = x1 + x2;
        let tmp_b2 = x1 - x2;
        x1 = tmp_a2;
        x2 = tmp_b2;
        let tmp_a3 = x0 + x3;
        let tmp_b3 = x0 - x3;
        x0 = tmp_a3;
        x3 = tmp_b3;
        x4 <<= 7;
        x7 <<= 7;
        let tmp_a4 = x7 + x4;
        let tmp_b4 = x7 - x4;
        x7 = tmp_a4;
        x4 = tmp_b4;
        x6 = x6 * 181;
        x5 = x5 * 181;
        let tmp_a5 = x7 + x5;
        let tmp_b5 = x7 - x5;
        x7 = tmp_a5;
        x5 = tmp_b5;
        let tmp_a6 = x4 + x6;
        let tmp_b6 = x4 - x6;
        x4 = tmp_a6;
        x6 = tmp_b6;
        let (tmp_a7, tmp_b7) = dct_box(x4 >> 2, x7 >> 2, 3406, -2276);
        x4 = tmp_a7;
        x7 = tmp_b7;
        let (tmp_a8, tmp_b8) = dct_box(x5 >> 2, x6 >> 2, 4017, -799);
        x5 = tmp_a8;
        x6 = tmp_b8;
        let tmp_a9 = x0 + x7;
        let tmp_b9 = x0 - x7;
        x0 = tmp_a9;
        x7 = tmp_b9;
        let tmp_a10 = x1 + x6;
        let tmp_b10 = x1 - x6;
        x1 = tmp_a10;
        x6 = tmp_b10;
        let tmp_a11 = x2 + x5;
        let tmp_b11 = x2 - x5;
        x2 = tmp_a11;
        x5 = tmp_b11;
        let tmp_a12 = x3 + x4;
        let tmp_b12 = x3 - x4;
        x3 = tmp_a12;
        x4 = tmp_b12;
        b[8 * i + 0] = x0;
        b[8 * i + 1] = x1;
        b[8 * i + 2] = x2;
        b[8 * i + 3] = x3;
        b[8 * i + 4] = x4;
        b[8 * i + 5] = x5;
        b[8 * i + 6] = x6;
        b[8 * i + 7] = x7;
    }
}

fn inverse_columns(b: Vec[i32]) -> () {
    for i in 0..8 {
        let mut x0 = b[0 * 8 + i];
        let mut x7 = b[1 * 8 + i];
        let mut x2 = b[2 * 8 + i];
        let mut x5 = b[3 * 8 + i];
        let mut x1 = b[4 * 8 + i];
        let mut x6 = b[5 * 8 + i];
        let mut x3 = b[6 * 8 + i];
        let mut x4 = b[7 * 8 + i];
        x0 += 1 << 19;
        let tmp_a0 = (x0 + x1) >> 2;
        let tmp_b0 = (x0 - x1) >> 2;
        x0 = tmp_a0;
        x1 = tmp_b0;
        let (tmp_a1, tmp_b1) = dct_box(x2 >> 13, x3 >> 13, 1108, -2676);
        x2 = tmp_a1;
        x3 = tmp_b1;
        let tmp_a2 = x1 + x2;
        let tmp_b2 = x1 - x2;
        x1 = tmp_a2;
        x2 = tmp_b2;
        let tmp_a3 = x0 + x3;
        let tmp_b3 = x0 - x3;
        x0 = tmp_a3;
        x3 = tmp_b3;
        let tmp_a4 = x7 + x4;
        let tmp_b4 = x7 - x4;
        x7 = tmp_a4;
        x4 = tmp_b4;
        x5 = (x5 >> 13) * 11585;
        x6 = (x6 >> 13) * 11585;
        let tmp_a5 = x7 + x5;
        let tmp_b5 = x7 - x5;
        x7 = tmp_a5;
        x5 = tmp_b5;
        let tmp_a6 = x4 + x6;
        let tmp_b6 = x4 - x6;
        x4 = tmp_a6;
        x6 = tmp_b6;
        let (tmp_a7, tmp_b7) = dct_box(x4 >> 14, x7 >> 14, 3406, -2276);
        x4 = tmp_a7;
        x7 = tmp_b7;
        let (tmp_a8, tmp_b8) = dct_box(x5 >> 14, x6 >> 14, 4017, -799);
        x5 = tmp_a8;
        x6 = tmp_b8;
        let tmp_a9 = x0 + x7;
        let tmp_b9 = x0 - x7;
        x0 = tmp_a9;
        x7 = tmp_b9;
        let tmp_a10 = x1 + x6;
        let tmp_b10 = x1 - x6;
        x1 = tmp_a10;
        x6 = tmp_b10;
        let tmp_a11 = x2 + x5;
        let tmp_b11 = x2 - x5;
        x2 = tmp_a11;
        x5 = tmp_b11;
        let tmp_a12 = x3 + x4;
        let tmp_b12 = x3 - x4;
        x3 = tmp_a12;
        x4 = tmp_b12;
        x0 >>= 18;
        x1 >>= 18;
        x2 >>= 18;
        x3 >>= 18;
        x4 >>= 18;
        x5 >>= 18;
        x6 >>= 18;
        x7 >>= 18;
        b[0 * 8 + i] = x0;
        b[1 * 8 + i] = x1;
        b[2 * 8 + i] = x2;
        b[3 * 8 + i] = x3;
        b[4 * 8 + i] = x4;
        b[5 * 8 + i] = x5;
        b[6 * 8 + i] = x6;
        b[7 * 8 + i] = x7;
    }
}
